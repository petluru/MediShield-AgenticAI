# Copy this file to .env and fill in real values. Never commit .env.

# --- LLM provider ---
ANTHROPIC_API_KEY=sk-ant-...

# One model string per agent (see PROJECT_PLAN.md §4 for rationale). Never
# hardcode model names in agent code — always read from Settings.
CLASSIFIER_MODEL=claude-sonnet-5
KYC_MODEL=claude-sonnet-5
CLAIMS_MODEL=claude-sonnet-5
POLICY_RAG_MODEL=claude-sonnet-5
FRAUD_MODEL=claude-sonnet-5
ORCHESTRATOR_MODEL=claude-sonnet-5
# Used by Fraud Detection (score 0.2-0.5) and Orchestrator (ESCALATE-bound
# cases) instead of the base model above, per the deterministic escalation
# rule in PROJECT_PLAN.md §4.
ESCALATION_MODEL=claude-opus-5

# --- Orchestrator decision thresholds (assignment §Component 8) ---
FRAUD_APPROVE_MAX=0.3
FRAUD_ESCALATE_MIN=0.3
CONFIDENCE_ESCALATE_MAX=0.6
# Fraud Detection Agent escalates its own model call (sonnet -> opus) when
# its preliminary score lands strictly inside this band.
FRAUD_MODEL_ESCALATION_LOW=0.2
FRAUD_MODEL_ESCALATION_HIGH=0.5

# --- LangSmith tracing (optional, bonus challenge) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=medishield-intake

# --- Storage ---
CASE_DB_PATH=./storage/cases.db
UPLOAD_DIR=./storage/uploads
CHROMA_PERSIST_DIR=./backend/rag/chroma_db
# Exact-match LLM response cache (context engineering layer, PROJECT_PLAN §5)
LLM_CACHE_PATH=./storage/llm_cache.db
# LangGraph checkpointer backing HITL interrupt()/Command(resume=...) (§6)
CHECKPOINT_DB_PATH=./storage/checkpoints.db
# Every live LLM call appends one JSON line here (agent, model, token counts) —
# see TOKEN_USAGE_LOG.md for the human-readable summary.
TOKEN_USAGE_LOG_PATH=./storage/token_usage.jsonl

# --- Dev cost controls ---
# When true, every agent is forced onto TESTING_MODEL regardless of its
# configured production model — for cheap "does the pipeline run" smoke
# tests only, not for prompt/behavior tuning. Leave false by default.
USE_CHEAP_MODELS_FOR_TESTING=false
TESTING_MODEL=claude-haiku-4-5

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# --- Security ---
# Comma-separated list of allowed API keys for the ingestion API (demo auth only).
API_AUTH_TOKENS=dev-local-token
